{
  "spec_id": "final_categories_v2",
  "spec_version": "1.0",
  "resource": "categories",
  "model": "Category",
  "controller": "CategoryController",
  "fields": [
    {
      "name": "name",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:48"
      ]
    },
    {
      "name": "description",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:160"
      ]
    }
  ],
  "operations": {
    "index": {
      "success_status": 200
    },
    "store": {
      "success_status": 201,
      "validation_error_status": 422
    },
    "show": {
      "success_status": 200,
      "not_found_status": 404
    },
    "update": {
      "success_status": 200,
      "validation_error_status": 422,
      "not_found_status": 404
    },
    "destroy": {
      "success_status": 204,
      "not_found_status": 404
    }
  }
}
