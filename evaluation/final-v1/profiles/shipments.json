        "type": "string",
        "rules": [
          "required",
          "string",
          "max:20",
          "unique:shipments,reference_code"
        ]
      },
      {
        "name": "quantity",
        "type": "integer",
        "rules": [
          "required",
          "integer",
          "min:1",
          "max:5000"
        ]
      },
      {
        "name": "priority",
        "type": "integer",
        "rules": [
          "required",
          "integer",
          "min:1",
          "max:5"
        ]
      },
      {
        "name": "note",
        "type": "string",
        "rules": [
          "required",
          "string",
          "max:120"
        ]
      }
    ],
    "operations": {
      "index": {
        "success_status": 200
      },
      "store": {
        "success_status": 201,
        "validation_error_status": 422
