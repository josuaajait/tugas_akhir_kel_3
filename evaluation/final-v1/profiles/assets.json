      "show": {
        "success_status": 200,
        "not_found_status": 404
      },
      "update": {
        "success_status": 200,
        "validation_error_status": 422,
        "not_found_status": 404
      },
      "destroy": {
        "success_status": 204,
        "not_found_status": 404
      }
    }
  },
