      },
      {
        "name": "name",
        "type": "string",
        "rules": [
          "required",
          "string",
          "max:80"
        ]
      },
      {
        "name": "value",
        "type": "integer",
        "rules": [
          "required",
          "integer",
          "min:0",
          "max:1000000"
        ]
      }
    ],
    "operations": {
      "index": {
        "success_status": 200
      },
      "store": {
        "success_status": 201,
        "validation_error_status": 422
