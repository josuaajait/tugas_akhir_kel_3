{
  "spec_id": "final_rooms_v1",
  "spec_version": "1.0",
  "resource": "rooms",
  "model": "Room",
  "controller": "RoomController",
  "fields": [
    {
      "name": "label",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:40"
      ]
    },
    {
      "name": "capacity",
      "type": "integer",
      "rules": [
        "required",
        "integer",
        "min:1",
        "max:500"
      ]
    }
  ],
  "operations": {
    "index": {
      "success_status": 200
    },
    "store": {
      "success_status": 201,
      "validation_error_status": 422
    },
    "show": {
      "success_status": 200,
      "not_found_status": 404
    },
    "update": {
      "success_status": 200,
      "validation_error_status": 422,
      "not_found_status": 404
    },
    "destroy": {
      "success_status": 204,
      "not_found_status": 404
    }
  }
}
