{
  "suite_id": "inventory_items-reference-development-v1",
  "stage": "development",
  "spec": {
    "spec_id": "inventory_items_basic",
    "spec_version": "1.0",
    "resource": "inventory_items",
    "model": "StockItem",
    "controller": "StockItemController",
    "fields": [
      {
        "name": "label",
        "type": "string",
        "rules": [
          "required",
          "string",
          "max:80"
        ]
      },
      {
        "name": "stock",
        "type": "integer",
        "rules": [
          "required",
          "integer",
          "min:0",
          "max:9999"
        ]
      },
      {
        "name": "warehouse_code",
        "type": "string",
        "rules": [
          "required",
          "string",
          "max:24",
          "unique:inventory_items,warehouse_code"
        ]
      },
      {
        "name": "reorder_level",
        "type": "integer",
        "rules": [
          "required",
          "integer",
          "min:0",
          "max:500"
        ]
      }
    ],
    "operations": {
      "index": {
        "success_status": 200
      },
      "store": {
        "success_status": 201,
        "validation_error_status": 422
      },
      "show": {
        "success_status": 200,
        "not_found_status": 404
      },
      "update": {
        "success_status": 200,
        "validation_error_status": 422,
        "not_found_status": 404
      },
      "destroy": {
        "success_status": 204,
        "not_found_status": 404
      }
    }
  },
  "fixtures": {
    "new": {
      "label": "New crate",
      "stock": 31,
      "warehouse_code": "EVAL-NEW",
      "reorder_level": 3
    },
    "target": {
      "label": "Old crate",
      "stock": 8,
      "warehouse_code": "EVAL-TARGET",
      "reorder_level": 2
    },
    "other": {
      "label": "Neighbour crate",
      "stock": 220,
      "warehouse_code": "EVAL-KEEP",
      "reorder_level": 5
    },
    "updated": {
      "label": "Revised crate",
      "stock": 104,
      "warehouse_code": "EVAL-CHANGED",
      "reorder_level": 6
    }
  },
