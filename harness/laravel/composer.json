{
  "name": "critic-agent/laravel-harness",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^12.0", "ext-pdo": "*", "ext-pdo_sqlite": "*"},
  "require-dev": {"phpunit/phpunit": "^11.5", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "config": {"sort-packages": true, "platform": {"php": "8.3.30"}, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
