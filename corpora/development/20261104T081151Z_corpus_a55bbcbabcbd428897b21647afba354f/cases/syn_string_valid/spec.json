{
  "spec_id": "books_basic",
  "spec_version": "1.0",
  "resource": "books",
  "model": "Book",
  "controller": "BookController",
  "fields": [
    {
      "name": "title",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:80"
      ]
    },
    {
      "name": "pages",
      "type": "integer",
      "rules": [
        "required",
        "integer",
        "min:1",
        "max:5000"
      ]
    }
  ],
  "operations": {
    "index": {
      "success_status": 200
    },
    "store": {
      "success_status": 201,
      "validation_error_status": 422
    },
    "show": {
      "success_status": 200,
      "not_found_status": 404
    },
    "update": {
      "success_status": 200,
      "validation_error_status": 422,
      "not_found_status": 404
    },
    "destroy": {
      "success_status": 204,
      "not_found_status": 404
    }
  }
}
