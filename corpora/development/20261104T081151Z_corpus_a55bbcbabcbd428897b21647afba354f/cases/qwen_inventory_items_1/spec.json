{
  "spec_id": "inventory_items_basic",
  "spec_version": "1.0",
  "resource": "inventory_items",
  "model": "StockItem",
  "controller": "StockItemController",
  "fields": [
    {
      "name": "label",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:80"
      ]
    },
    {
      "name": "stock",
      "type": "integer",
      "rules": [
        "required",
        "integer",
        "min:0",
        "max:9999"
      ]
    },
    {
      "name": "warehouse_code",
      "type": "string",
      "rules": [
        "required",
        "string",
        "max:24",
        "unique:inventory_items,warehouse_code"
      ]
    },
    {
      "name": "reorder_level",
      "type": "integer",
      "rules": [
        "required",
        "integer",
        "min:0",
        "max:500"
      ]
    }
  ],
  "operations": {
    "index": {
      "success_status": 200
    },
    "store": {
      "success_status": 201,
      "validation_error_status": 422
    },
    "show": {
      "success_status": 200,
      "not_found_status": 404
    },
    "update": {
      "success_status": 200,
      "validation_error_status": 422,
      "not_found_status": 404
    },
    "destroy": {
      "success_status": 204,
      "not_found_status": 404
    }
  }
}
